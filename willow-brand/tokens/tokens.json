{
  "$description": "Willow visual identity v2, locked 17 November 2026. Source of truth for colour, type, spacing and radius. Format: W3C Design Tokens (DTCG). Edit this file, then run: python3 scripts/build_tokens.py",
  "color": {
    "$type": "color",
    "dusk": {
      "$description": "Dark theme. Covers, hero sections, social posts, WhisperPosters.com, anything read in one line.",
      "ground": {"$value": "#1D1F1C", "$description": "Ink. Page background."},
      "surface-raised": {"$value": "#272A26", "$description": "Night. Header, popovers."},
      "surface": {"$value": "#343B32", "$description": "Moss. Cards and sections."},
      "text": {"$value": "#EDEAE3", "$description": "Moon. Body and headings."},
      "text-muted": {"$value": "#C9C4BB", "$description": "Ash. Captions, metadata."},
      "accent": {"$value": "#A6B0A0", "$description": "Sprig. Links, labels, one emphasised word."},
      "accent-fill": {"$value": "#A6B0A0", "$description": "Primary button fill."},
      "on-accent": {"$value": "#1D1F1C", "$description": "Text on the primary button."},
      "line": {"$value": "#3E453B", "$description": "Decorative hairlines only."},
      "line-control": {"$value": "#7D8A76", "$description": "Sage. Input and secondary-button borders."},
      "focus": {"$value": "#A6B0A0", "$description": "Focus ring, 2px solid, 2px offset."}
    },
    "daylight": {
      "$description": "Light theme and the default. PDF interiors, guides, workbooks, documents, letterhead, articles, checkout, print.",
      "ground": {"$value": "#F7F4EF", "$description": "Bone. Page background."},
      "surface-raised": {"$value": "#FBF9F6", "$description": "Header, popovers."},
      "surface": {"$value": "#ECE7DF", "$description": "Linen. Cards and sections."},
      "text": {"$value": "#2B2926", "$description": "Bark. Body and headings."},
      "text-muted": {"$value": "#5C5852", "$description": "Captions, metadata."},
      "accent": {"$value": "#4E5947", "$description": "Willow Deep. Links, labels."},
      "accent-fill": {"$value": "#5F6B58", "$description": "Willow. Primary button fill."},
      "on-accent": {"$value": "#F7F4EF", "$description": "Text on the primary button."},
      "line": {"$value": "#D3CCC2", "$description": "Stone. Decorative hairlines only."},
      "line-control": {"$value": "#857D71", "$description": "Input and secondary-button borders."},
      "focus": {"$value": "#4E5947", "$description": "Focus ring."}
    },
    "mist": {
      "$description": "Low-contrast theme. Optional reading mode and soft-print editions. Offered, never the default.",
      "ground": {"$value": "#D8D8CF", "$description": "Mist. Page background."},
      "surface-raised": {"$value": "#E0E0D9", "$description": "Haze. Header, popovers."},
      "surface": {"$value": "#CDCDC3", "$description": "Fog. Cards and sections."},
      "text": {"$value": "#3F413A", "$description": "Loam. Body and headings."},
      "text-muted": {"$value": "#51544C", "$description": "Reed. Captions, metadata."},
      "accent": {"$value": "#4E5947", "$description": "Willow Deep. Links, labels."},
      "accent-fill": {"$value": "#4E5947", "$description": "Primary button fill."},
      "on-accent": {"$value": "#E0E0D9", "$description": "Text on the primary button."},
      "line": {"$value": "#BDBDB2", "$description": "Decorative hairlines only."},
      "line-control": {"$value": "#72726A", "$description": "Input and secondary-button borders."},
      "focus": {"$value": "#3F413A", "$description": "Focus ring."}
    },
    "pillar": {
      "$description": "One willow ink in five depths, pale to deep. A depth is a GROUND (cover, band, panel, chip), never a text colour. Always shown with numeral and name, e.g. 'III · Wayfinder'. Same in every theme.",
      "nest": {"$value": "#D2DBCA", "$description": "I · Nest. Text on it: on-nest."},
      "on-nest": {"$value": "#2B2926"},
      "academy": {"$value": "#AFB8A7", "$description": "II · Academy."},
      "on-academy": {"$value": "#2B2926"},
      "wayfinder": {"$value": "#8D9686", "$description": "III · Wayfinder. Text on it 15px / 11pt or larger."},
      "on-wayfinder": {"$value": "#2B2926"},
      "workshop": {"$value": "#4E5547", "$description": "IV · Workshop."},
      "on-workshop": {"$value": "#EDEAE3"},
      "studio": {"$value": "#2F3628", "$description": "V · Studio. Needs a hairline edge on Dusk."},
      "on-studio": {"$value": "#EDEAE3"}
    }
  },
  "font": {
    "$type": "fontFamily",
    "mark": {"$value": ["Cormorant Garamond", "Georgia", "serif"], "$description": "Logos and cover titles only, 40px / 30pt and up."},
    "display": {"$value": ["Newsreader", "Georgia", "serif"], "$description": "Headings, titles, lede. Upright 400."},
    "sans": {"$value": ["Atkinson Hyperlegible Next", "system-ui", "sans-serif"], "$description": "All reading and interface text."},
    "mono": {"$value": ["IBM Plex Mono", "Menlo", "monospace"], "$description": "SKUs, footers, metadata."}
  },
  "typography": {
    "$type": "typography",
    "display":  {"$value": {"fontFamily": "{font.display}", "fontSize": "72px", "fontWeight": 400, "lineHeight": 1.0, "letterSpacing": "-0.02em"}, "$description": "One line per page at most. Print 40pt."},
    "headline": {"$value": {"fontFamily": "{font.display}", "fontSize": "44px", "fontWeight": 400, "lineHeight": 1.1, "letterSpacing": "-0.01em"}, "$description": "Section openers. Print 26pt."},
    "title":    {"$value": {"fontFamily": "{font.display}", "fontSize": "28px", "fontWeight": 400, "lineHeight": 1.2, "letterSpacing": "0"}, "$description": "Card and product titles. Print 18pt."},
    "lede":     {"$value": {"fontFamily": "{font.display}", "fontSize": "21px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0"}, "$description": "One sentence under a headline, muted. Print 14pt."},
    "quote":    {"$value": {"fontFamily": "{font.display}", "fontSize": "26px", "fontWeight": 400, "lineHeight": 1.35, "letterSpacing": "0"}, "$description": "The only italic: one short pull line per view."},
    "body":     {"$value": {"fontFamily": "{font.sans}", "fontSize": "17px", "fontWeight": 400, "lineHeight": 1.65, "letterSpacing": "0.02em"}, "$description": "All running text. Print 12pt minimum."},
    "small":    {"$value": {"fontFamily": "{font.sans}", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0.02em"}, "$description": "Captions, prices. Print 10pt."},
    "button":   {"$value": {"fontFamily": "{font.sans}", "fontSize": "16px", "fontWeight": 600, "lineHeight": 1.0, "letterSpacing": "0.01em"}, "$description": "Button labels, sentence case."},
    "label":    {"$value": {"fontFamily": "{font.sans}", "fontSize": "13px", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "0.1em"}, "$description": "Uppercase eyebrows, five words max. Print 9pt."},
    "meta":     {"$value": {"fontFamily": "{font.mono}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0"}, "$description": "SKUs, footers, page numbers. Print 8.5pt."}
  },
  "space": {
    "$type": "dimension",
    "1": {"$value": "4px"}, "2": {"$value": "8px"}, "3": {"$value": "12px"}, "4": {"$value": "16px"},
    "6": {"$value": "24px"}, "8": {"$value": "32px"}, "12": {"$value": "48px"}, "16": {"$value": "64px", "$description": "Between sections, mobile."},
    "24": {"$value": "96px", "$description": "Between sections, desktop."}
  },
  "radius": {
    "$type": "dimension",
    "none": {"$value": "0px", "$description": "Images, full-bleed sections."},
    "sm": {"$value": "4px", "$description": "Inputs, tags."},
    "md": {"$value": "10px", "$description": "Cards, product tiles."},
    "pill": {"$value": "999px", "$description": "Buttons."}
  }
}
